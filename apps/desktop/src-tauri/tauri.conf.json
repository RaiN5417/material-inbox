{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Inbox",
  "version": "0.1.0",
  "identifier": "dev.downloadinbox.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Download Inbox",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
