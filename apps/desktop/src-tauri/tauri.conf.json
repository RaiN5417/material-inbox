{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Inbox",
  "version": "0.2.1",
  "identifier": "dev.downloadinbox.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Download Inbox",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Download Inbox Contributors",
    "copyright": "Copyright © 2026 Download Inbox Contributors",
    "homepage": "https://github.com/RaiN5417/material-inbox",
    "shortDescription": "Downloads 文件夹不该是个杂物抽屉——本地优先的下载文件归档小工具",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
